# Primary LLM provider: "gemini" | "openai" | "local" (Ollama)
LLM_PROVIDER="gemini"

# Google Gemini API Key (required for Gemini LLM and embeddings)
GEMINI_API_KEY="your_gemini_api_key_here"

# Pinecone API Key (required for vector index retrieval)
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_ENVIRONMENT="us-east-1"
PINECONE_INDEX_NAME="goose-manuals"

# Optional Cohere API Key (for Cohere Rerank v3; falls back to score sorting if omitted)
COHERE_API_KEY="your_cohere_api_key_here_optional"

# Optional OpenAI API Key (if LLM_PROVIDER="openai")
OPENAI_API_KEY="your_openai_api_key_here_optional"

# Optional Local LLM endpoint (if LLM_PROVIDER="local")
LOCAL_LLM_ENDPOINT="http://localhost:11434"
