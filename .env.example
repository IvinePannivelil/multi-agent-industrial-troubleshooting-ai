# Goose Ecosystem Root Environment Configuration
# Copy this file to .env or configure in individual app folders

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone Vector Database API Key
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=goose-manuals

# Optional Services
COHERE_API_KEY=your_cohere_api_key_here_optional
OPENAI_API_KEY=your_openai_api_key_here_optional
LOCAL_LLM_ENDPOINT=http://localhost:11434
NEXT_PUBLIC_API_URL=http://localhost:8001
